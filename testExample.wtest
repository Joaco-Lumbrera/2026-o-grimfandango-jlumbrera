import paquetes.*
import programa.*
import estrategias.*

describe "un agente determina correctamente el paquete" {
  const vendedor = new Agente(deuda = 100,cantidadPaquetesVendidos = 0, estrategia = navegante)

  test "agente 007 ofrece como mejor plan el crucero" {
    const alma = new Alma(dinero = 100, accionesBuenas= 51)
    const paquete = vendedor.paqueteParaOfrecer(alma)

    assert.equals(51, paquete.valorBasico())
  }

}